# -------- App -------- #
PROJECT_NAME=MyFastAPIGuide
ENVIRONMENT=dev
HOST=0.0.0.0
PORT=8000


# -------- Database -------- #
DATABASE_URL = 'postgresql://postgres:postgres@localhost:5432/fastapi_guide'


# -------- Security -------- #
SECRET_KEY=your-super-secret-key-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# -------- CORS -------- #
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
