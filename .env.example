# ===========================================================================
# APP SETTINGS
# ===========================================================================

APP_NAME=project_name # PROJECT_NAME
APP_VERSION=1.0.0

ENVIRONMENT=development # local | development | staging | production | test
DEBUG=true # true | false

API_V1_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8000


# =====================================================
# DATABASE
# =====================================================

# SQLITE DATABASE URL
DATABASE_URL=sqlite:///./fastapi_guide.db
ASYNC_DB_URL=sqlite:///./fastapi_guide.db

# PostgreSQL DATABASE URL
# database type/driver → username : password → database host → PostgreSQL port (default) → database name
DATABASE_URL = 'postgresql://postgres:postgres@localhost:5432/fastapi_guide'
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/database_name
ASYNC_DB_URL=postgresql+asyncpg://user:password@localhost:5432/database_name


# ===========================================================================
# CORS SETTINGS
# ===========================================================================

# BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]


# ===========================================================================
# SECURITY SETTINGS
# ===========================================================================

# openssl rand -hex 32
SECRET_KEY=your-super-secret-key-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# =====================================================
# REDIS
# =====================================================

REDIS_URL=redis://localhost:6379
CACHE_TTL=3600


# =====================================================
# LOGGING
# =====================================================

LOG_LEVEL=INFO


# ===========================================================================
# Allowed hosts (for production)
# ===========================================================================
# ALLOWED_HOSTS=localhost,127.0.0.1,api.example.com


# ENV
# .env.local
# .env.test
# .env.staging
# .env.production
# .env.example